{
  "name": "cpg-me-daddy",
  "displayName": "cpg-me-daddy",
  "description": "Code Property Graph for TypeScript/JavaScript/Python",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cpg-me-daddy.helloWorld",
        "title": "CPG: Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "clean": "tsc -b --clean && rm -rf out",
    "check:deps": "node tools/check-deps.mjs",
    "test": "vitest run",
    "verify": "npm run check:deps && npm run compile && npm run test"
  },
  "dependencies": {
    "@cpg/model": "*"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

{
  "name": "cpg-me-daddy",
  "displayName": "cpg-me-daddy",
  "description": "Code Property Graph for TypeScript/JavaScript/Python",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=24"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cpg-me-daddy.helloWorld",
        "title": "CPG: Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "clean": "tsc -b --clean && rm -rf out",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "check:deps": "node tools/check-deps.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run check",
    "typecheck": "tsc -b",
    "check": "npm run format:check && npm run lint && npm run knip && npm run check:deps && npm run typecheck && npm run test:coverage",
    "check:gates": "node tools/prove-gates.mjs"
  },
  "dependencies": {
    "@cpg/model": "*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.10.3",
    "knip": "^6.47.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@11.8.0"
}

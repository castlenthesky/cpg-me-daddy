{
  "name": "cpg-me-daddy",
  "displayName": "cpg-me-daddy",
  "description": "Code Property Graph for TypeScript/JavaScript/Python",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=24"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:cpg.graph"
  ],
  "main": "./apps/vscode/dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cpg.openGraph",
        "title": "CPG: Open Graph"
      },
      {
        "command": "cpg.verify",
        "title": "CPG: Verify"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -b && node tools/build-inspector.mjs",
    "watch": "tsc -b -w",
    "clean": "node tools/clean.mjs",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "check:deps": "node tools/check-deps.mjs",
    "check:pack": "node tools/check-pack.mjs",
    "check:coords": "node tools/check-archive-coords.mjs",
    "check:unit-diff": "node tools/check-unit-diff.mjs",
    "check:cli-bin": "node tools/check-cli-bin.mjs",
    "check:purity": "node tools/purity-proof.mjs && node tools/purity-proof.mjs --plant",
    "schema:doc": "node tools/schema-doc.mjs",
    "check:schema": "node tools/schema-doc.mjs --check",
    "build:inspector": "node tools/build-inspector.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "bun run check",
    "typecheck": "tsc -b && tsc -p apps/inspector/tsconfig.page.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "check": "node tools/check.mjs",
    "check:gates": "node tools/prove-gates.mjs",
    "ladder:oracle": "node tools/ladder-oracle.mjs",
    "test:mutation": "stryker run",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@cpg/engine": "*",
    "@cpg/inspector": "*",
    "@cpg/model": "*"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.146.0",
    "@vitest/coverage-v8": "^5.1.1",
    "basedpyright": "^1.40.2",
    "esbuild": "0.28.2",
    "fast-check": "^4.11.0",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.1.0",
    "vitest": "^5.1.1",
    "yaml": "2.9.1"
  },
  "packageManager": "bun@1.4.5"
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // Inside outDir so deleting dist/ always forces a re-emit (never a stale "up to date").
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test-d.ts", "src/**/*.spec.ts"],
  // ../inspector: cpg index --inspect spawns its built bin (owner decision 9a), so tsc -b builds it
  // first; no inspector code is imported (controller decision 16 resolves a path only).
  "references": [
    { "path": "../../packages/engine" },
    { "path": "../../packages/model" },
    { "path": "../inspector" }
  ]
}

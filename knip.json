{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // tools/*.mjs are run by package scripts / node directly, so are entries.
      "entry": ["tools/*.mjs"],
      "project": ["tools/**/*.mjs"],
      // The root package.json is the extension manifest, and vsce ships only its dependencies:
      // apps/vscode/dist/extension.js loads these at runtime, so the root must list them.
      // @vscode/test-cli imports @vscode/test-electron by name, only when it runs.
      "ignoreDependencies": ["@cpg/engine", "@cpg/inspector", "@cpg/model", "@vscode/test-electron"]
    },
    // Entry src/extension.ts is detected from package.json "main" (dist -> src).
    "apps/vscode": {
      // Run by @vscode/test-cli (tools/vscode-host.config.mjs, tools/vscode-spikes.config.mjs).
      "entry": ["host-tests/*.test.ts", "host-tests/spikes/*.spike.ts"],
      "project": ["src/**/*.ts", "host-tests/**/*.ts"],
      // The extension host provides `vscode` at runtime. Its types are @types/vscode in the root
      // manifest, next to engines.vscode.
      "ignoreDependencies": ["vscode"]
    },
    // Entry src/index.ts is detected from package.json "main"/"types" (dist -> src).
    "packages/model": {
      "project": ["src/**/*.ts"]
    },
    "packages/parse": {
      "project": ["src/**/*.ts"]
    },
    "packages/resolve": {
      "project": ["src/**/*.ts"]
    },
    "packages/watch": {
      "project": ["src/**/*.ts"]
    },
    "packages/engine": {
      "project": ["src/**/*.ts"]
    },
    "packages/sink": {
      "project": ["src/**/*.ts"]
    },
    "packages/store": {
      "project": ["src/**/*.ts"]
    },
    "apps/cli": {
      "project": ["src/**/*.ts"]
    },
    // The page bundle's entry, built by tools/build-inspector.mjs.
    "apps/inspector": {
      "entry": ["src/graph-page.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  // knip's lefthook plugin only counts lefthook as used when CI is set or .git/hooks are
  // installed. A clone installed with LEFTHOOK=0 or --ignore-scripts would fail with a false
  // "unused devDependency", and turbo doesn't hash either condition. lefthook.yml is the real use.
  "ignoreDependencies": ["lefthook"]
}

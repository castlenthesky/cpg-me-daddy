{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "/build/**",
    "/design/**",
    "/media/**",
    "/out/**",
    "/resources/**",
    "/scripts/**",
    "/src/**",
    "/test/**",
    "/.agent/**",
    "/.vscode/**",
    "/.claude/**",
    "**/*.md",
    "**/dist/**",
    "bun.lock"
  ],
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": true
}

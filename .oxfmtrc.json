{
  // Only non-default choices are listed. Defaults already match the code (semi, trailingComma "all",
  // 2-space indent, lf). singleQuote and printWidth are set to match the existing hand-written style
  // and keep the one-time reformat diff small.
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  // Default would reorder package.json keys (e.g. scripts, engines); npm/VS Code manifest order is
  // meaningful to humans here, so keep it as written.
  "sortPackageJson": false,
  "ignorePatterns": [
    // Generated / vendored / lockfile content: never hand-formatted.
    "dist",
    "out",
    "node_modules",
    "package-lock.json",
    // Machine-local, git-ignored (user-global ignore) tool state; not ours to format.
    ".claude/settings.local.json",
    // docs/** is hand-written prose/YAML with intentional layout (long folded scalars, flow lists);
    // oxfmt rewrites ~7k lines of it, which is churn with no value. Benchmark JSON is generated data.
    "docs/**"
  ]
}

{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:gates)",
      "Bash(npm run check:deps)",
      "Bash(npm run format:check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run knip)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npm test)",
      "Bash(npm run format)",
      "Bash(npm run lint:fix)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/tools/claude-post-edit.mjs"
          }
        ]
      }
    ]
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    // Legacy, pre-monorepo trees: reference only, excluded from every gate.
    // NOTE: these patterns do NOT exclude sibling git worktrees under
    // .claude/worktrees/ — oxlint's config-level ignorePatterns do not match
    // dot-directories. The `packages` argument in the root `lint` script is
    // what keeps those out. See also --ignore-pattern, which does work.
    "**/dist/**",
    "**/out/**",
    "**/node_modules/**",
    "/build/**",
    "/design/**",
    "/media/**",
    "/resources/**",
    "/scripts/**",
    "/src/**",
    "/test/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "es2022": true,
    "node": true
  },
  "rules": {
    "curly": "error",
    "eqeqeq": "error",
    "no-throw-literal": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      // Engine purity (F1 gate). packages/engine is the pure core: it runs
      // unchanged inside the extension host, the CLI and a headless daemon, so
      // it must never reach for an editor API. packages/falkordb-service sits
      // below the engine and inherits the same rule.
      "files": ["packages/engine/**", "packages/falkordb-service/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "vscode",
                "message": "Engine purity: packages/engine must never import 'vscode'. Keep editor APIs in packages/vscode and pass plain data into the engine."
              }
            ],
            "patterns": [
              {
                "group": ["vscode/*", "@cpg/vscode", "@cpg/vscode/**"],
                "message": "Engine purity: the engine must never depend on the VS Code extension package."
              }
            ]
          }
        ]
      }
    },
    {
      // M0.4a: packages/engine must reach FalkorDB only through
      // falkordb-service's typed client/services (FalkorService, GraphService,
      // AdminService), never the raw `falkordb` driver package directly. Scoped
      // to packages/engine ONLY — falkordb-service itself legitimately depends
      // on `falkordb` (that dependency is the whole point of the package). Per
      // F1's rule that a gate nobody has seen fail is not a gate, this one is
      // proven red with a deliberately-violating file before being reverted
      // (M0.4a's PR).
      "files": ["packages/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "falkordb",
                "message": "packages/engine must never import the raw 'falkordb' driver directly. Go through falkordb-service's FalkorService/GraphService/AdminService instead."
              }
            ]
          }
        ]
      }
    },
    {
      // Package independence. falkordb-service is published for reuse in other
      // projects, so it must not know this one exists: no @cpg/* import, ever.
      // Everything cpg-specific reaches it as configuration — see
      // packages/engine/src/store/falkordb.config.ts.
      "files": ["packages/falkordb-service/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "vscode",
                "message": "falkordb-service must never import 'vscode'."
              }
            ],
            "patterns": [
              {
                "group": ["@cpg/*", "@cpg/**"],
                "message": "falkordb-service is a standalone, reusable package: it must not depend on any @cpg/* package. Anything cpg-specific belongs in packages/engine and reaches this package as config (see FalkorBranding)."
              }
            ]
          }
        ]
      }
    }
  ]
}

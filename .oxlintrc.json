{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    // Legacy, pre-monorepo trees: reference only, excluded from every gate.
    // NOTE: these patterns do NOT exclude sibling git worktrees under
    // .claude/worktrees/ — oxlint's config-level ignorePatterns do not match
    // dot-directories. The `packages` argument in the root `lint` script is
    // what keeps those out. See also --ignore-pattern, which does work.
    "**/dist/**",
    "**/out/**",
    "**/node_modules/**",
    "/build/**",
    "/design/**",
    "/media/**",
    "/resources/**",
    "/scripts/**",
    "/src/**",
    "/test/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "es2022": true,
    "node": true
  },
  "rules": {
    "curly": "error",
    "eqeqeq": "error",
    "no-throw-literal": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      // Engine purity (F1 gate). packages/engine is the pure core: it runs
      // unchanged inside the extension host, the CLI and a headless daemon, so
      // it must never reach for an editor API.
      "files": ["packages/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "vscode",
                "message": "Engine purity: packages/engine must never import 'vscode'. Keep editor APIs in packages/vscode and pass plain data into the engine."
              }
            ],
            "patterns": [
              {
                "group": ["vscode/*", "@cpg/vscode", "@cpg/vscode/**"],
                "message": "Engine purity: packages/engine must never depend on the VS Code extension package."
              }
            ]
          }
        ]
      }
    }
  ]
}

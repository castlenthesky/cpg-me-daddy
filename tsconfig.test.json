{
  // The ONE type-check for all test code (*.test.ts and *.test-d.ts), run by `bun run
  // typecheck:tests`. vitest strips types and `tsc -b` deliberately excludes tests from build
  // output, so without this a type error in a test (or a failed expectTypeOf) goes unseen.
  // noEmit: checking only, never produces output.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // contracts-agree (apps/cli) is the first test importing @cpg/* by package name. Without paths it
    // would resolve through node_modules to dist/*.d.ts, which typecheck:tests does not build first.
    // Listed one by one: @cpg/cli and @cpg/vscode-host live under apps/, so no @cpg/* wildcard.
    "paths": {
      "@cpg/engine": ["./packages/engine/src/index.ts"],
      "@cpg/model": ["./packages/model/src/index.ts"],
      "@cpg/parse": ["./packages/parse/src/index.ts"],
      "@cpg/resolve": ["./packages/resolve/src/index.ts"],
      "@cpg/watch": ["./packages/watch/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test-d.ts",
    "apps/*/src/**/*.test.ts",
    "apps/*/src/**/*.test-d.ts"
  ]
}

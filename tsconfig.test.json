{
  // The ONE type-check for all test code (*.test.ts and *.test-d.ts), run by `bun run
  // typecheck:tests`. vitest strips types and `tsc -b` deliberately excludes tests from build
  // output, so without this a type error in a test (or a failed expectTypeOf) goes unseen.
  // noEmit: checking only, never produces output.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test-d.ts",
    "apps/*/src/**/*.test.ts"
  ]
}

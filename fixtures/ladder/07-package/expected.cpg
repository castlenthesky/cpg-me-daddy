DECLARES file:shapes/square.py:MODULE:$root -> file:shapes/square.py:METHOD:area
HAS_PARAM file:shapes/square.py:METHOD:area -> file:shapes/square.py:PARAM:area.side
IN_SCOPE file:main.py:CALL:main:0 -> file:main.py:METHOD:main

[symbols]
DEFINES file:main.py:MODULE:$root -> `main.py`/
DEFINES file:main.py:METHOD:main -> `main.py`/main().

# Rung 07. A subdirectory package. Nested DIRECTORY/HAS_ENTRY, dotted module names, a dotted import.

[parse]
PARSE main.py language=python root=module hasError=false
PARSE shapes/__init__.py language=python root=module hasError=false
PARSE shapes/square.py language=python root=module hasError=false

[filesystem]
DIRECTORY dir:.
DIRECTORY dir:shapes name=shapes
FILE file:main.py name=main.py language=python
FILE file:shapes/__init__.py name=__init__.py language=python
FILE file:shapes/square.py name=square.py language=python
HAS_ENTRY dir:. -> dir:shapes
HAS_ENTRY dir:. -> file:main.py
HAS_ENTRY dir:shapes -> file:shapes/__init__.py
HAS_ENTRY dir:shapes -> file:shapes/square.py

[structural]

{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
    // Unused locals/parameters are deliberately NOT checked here: oxlint (no-unused-vars) is the
    // single owner, because it runs in the editor, the Claude post-edit hook and pre-commit.
  },
  "exclude": ["node_modules", "dist", "out", ".vscode-test", ".debate"]
}

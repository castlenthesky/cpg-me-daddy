{
  // Caching only. Every gate stays a plain root script (runnable directly); turbo just skips a
  // gate when NOTHING that can affect its result has changed. A failed task is never cached, so a
  // cache hit can only ever replay a previous success for byte-identical inputs.
  //
  // Root tasks ("//#name") because the repo has no per-package scripts to orchestrate.
  // Inputs are explicit (never the default) so that a config, tool script or tsconfig edit
  // invalidates the cache. Untracked files (e.g. a new, unstaged source file) count as inputs.
  "$schema": "https://turborepo.dev/schema.json",
  // Hashed into EVERY task: dependency versions and the Node major (tsc/oxlint/vitest behaviour).
  "globalDependencies": ["package.json", "bun.lock", ".node-version"],
  "tasks": {
    "//#format:check": {
      // oxfmt checks every non-ignored file type, so everything except what .oxfmtrc.json ignores
      // and what is generated output (outputs/logs would otherwise change the hash after a run).
      "inputs": [
        "**",
        "!docs/**",
        "!node_modules/**",
        "!**/node_modules/**",
        "!out/**",
        "!**/dist/**",
        "!coverage/**",
        "!.turbo/**",
        "!.git/**",
        "!.claude/settings.local.json",
        "!.claude/worktrees/**",
        "!**/.tsbuildinfo",
        "!bun.lock"
      ]
    },
    "//#lint": {
      // Root config files are matched by extension, and the extension list must cover every module
      // flavour: vitest.config.mts was once missed by "*.ts" and a config edit replayed a cache hit.
      // Type-aware: the result depends on all sources and on every tsconfig, not only .oxlintrc.json.
      // After typecheck: type-aware rules resolve @cpg/* through each package's dist/*.d.ts. Linting
      // before `tsc -b` (as CI did) sees those types as `any`, so a cast that is required locally
      // was reported as unnecessary in CI (PR #51).
      "dependsOn": ["//#typecheck"],
      "inputs": [
        "apps/**",
        "packages/**",
        "tools/**",
        "*.ts",
        "*.mts",
        "*.cts",
        "*.mjs",
        "*.cjs",
        "*.json",
        "*.jsonc",
        ".oxlintrc.json",
        "!packages/*/dist/**",
        "!apps/*/dist/**",
        "!**/.tsbuildinfo"
      ]
    },
    "//#knip": {
      // knip reads sources, every package.json (entries, deps) and knip.json.
      "inputs": [
        "apps/**",
        "packages/**",
        "tools/**",
        "*.ts",
        "*.mts",
        "*.cts",
        "*.mjs",
        "*.cjs",
        "*.json",
        "*.jsonc",
        // knip plugins read these too (lefthook binaries, CI workflow scripts, changeset config).
        "lefthook.yml",
        ".github/**",
        ".changeset/**",
        "!packages/*/dist/**",
        "!apps/*/dist/**",
        "!**/.tsbuildinfo"
      ]
    },
    "//#check:deps": {
      // tools/check-deps.mjs walks packages/** and apps/**, and scans packages/*/dist for stale
      // host-SDK imports, so dist is an input here; the script itself is an input.
      "dependsOn": ["//#typecheck"],
      "inputs": ["apps/**", "packages/**", "tools/**", "!apps/*/dist/**", "!**/.tsbuildinfo"]
    },
    "//#check:pack": {
      // Inspects built output, so it runs after the build and is keyed on that output.
      "dependsOn": ["//#typecheck"],
      "inputs": ["packages/*/dist/**", "packages/*/package.json", "tools/check-pack.mjs"]
    },
    "//#check:coords": {
      // Resolves docs/outline coordinates against the git object store, which no input glob can
      // see (a deleted keeping branch or a shallow clone changes the answer), so never cached.
      "cache": false
    },
    "//#check:schema": {
      // The doc is an input because no other task hashes docs/**: without it a hand edit of the
      // generated region would replay a cached pass.
      "dependsOn": ["//#typecheck"],
      "inputs": [
        "packages/model/src/**",
        "packages/model/tsconfig*.json",
        "tsconfig.base.json",
        "tools/schema-doc.mjs",
        "docs/outline/04-schema.yaml",
        "!**/.tsbuildinfo"
      ]
    },
    "//#typecheck": {
      "inputs": [
        "apps/**",
        "packages/**",
        "*.json",
        "!packages/*/dist/**",
        "!apps/*/dist/**",
        "!**/.tsbuildinfo"
      ],
      "outputs": ["apps/*/dist/**", "packages/*/dist/**", "!node_modules/**"]
    },
    "//#check:cli-bin": {
      // Builds and spawns apps/cli's bin (C-CLI I-6). After typecheck so two tsc -b never race on
      // apps/cli/dist; before test:coverage ("in CI before vitest").
      "dependsOn": ["//#typecheck"],
      "inputs": [
        "apps/cli/**",
        "packages/*/src/**",
        "tsconfig.base.json",
        "tools/check-cli-bin.mjs",
        // `cpg schema --check` runs on this repository's doc (U2a.4).
        "docs/outline/04-schema.yaml",
        "!apps/cli/dist/**",
        "!**/.tsbuildinfo"
      ],
      "outputs": ["apps/cli/dist/**"]
    },
    "//#check:purity": {
      // Requires the built bin in-process under a Module._load trap (U2c.3). After check:cli-bin,
      // which builds apps/cli, so dist is current and no two tsc -b race; the --plant run writes
      // only to packages/engine/out, which no task outputs and every tool ignores.
      "dependsOn": ["//#check:cli-bin"],
      "inputs": [
        "apps/cli/**",
        "packages/*/src/**",
        "packages/*/package.json",
        "packages/*/tsconfig*.json",
        "tsconfig.base.json",
        "tools/purity-proof.mjs",
        "fixtures/ladder/**",
        "!apps/cli/dist/**",
        "!**/.tsbuildinfo"
      ],
      "outputs": []
    },
    "//#typecheck:tests": {
      // tsc over every test file and the sources they import; no outputs (noEmit).
      "inputs": [
        "apps/*/src/**",
        "packages/*/src/**",
        "tsconfig*.json",
        "apps/*/tsconfig*.json",
        "packages/*/tsconfig*.json",
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "!packages/*/dist/**",
        "!apps/*/dist/**",
        "!**/.tsbuildinfo"
      ],
      "outputs": []
    },
    "//#test:coverage": {
      // tools/** holds tools/*.test.mjs and the scripts they run (check-deps.test.mjs).
      // fixtures/** is read by packages/model/src/ladder.test.ts; without it a fixture edit replays
      // a cached pass.
      "dependsOn": ["//#check:cli-bin"],
      "inputs": [
        "apps/**",
        "packages/**",
        "tools/**",
        "fixtures/**",
        "*.ts",
        "*.mts",
        "*.cts",
        "*.mjs",
        "*.cjs",
        "*.json",
        "*.jsonc",
        "!packages/*/dist/**",
        "!apps/*/dist/**",
        "!**/.tsbuildinfo"
      ],
      "outputs": ["coverage/**"]
    }
  }
}

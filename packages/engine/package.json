{
  "name": "@cpg/engine",
  "version": "0.0.1",
  "private": true,
  "description": "Pure TypeScript CPG engine. Must never import 'vscode'.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test:unit": "bun test test/unit",
    "test:schema": "bun test test/unit/schema",
    "test:integration": "bun test test/integration",
    "test:integration:network": "CPG_INTEGRATION_FALKORDB=1 bun test test/integration"
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "falkordb-service": "workspace:*",
    "web-tree-sitter": "0.27.0"
  }
}

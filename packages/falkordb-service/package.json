{
  "name": "falkordb-service",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable FalkorDB client, service facade and server lifecycle. Knows FalkorDB; knows nothing about any one application.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test:unit": "bun test test/unit",
    "test:integration:network": "CPG_INTEGRATION_FALKORDB=1 bun test test/integration"
  },
  "dependencies": {
    "falkordb": "6.8.0"
  }
}
